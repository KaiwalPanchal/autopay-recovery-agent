# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# LiveKit Configuration
LIVEKIT_URL=wss://recovery-demo.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Telephony / SIP Configuration (Optional carrier trunk)
INTERNAL_API_TOKEN=replace-with-a-long-random-token
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_SIP_CALLER_ID=

# Speech & Model Layer Configuration (Section 6)
# STT: Deepgram Nova-2 / Faster-Whisper / OpenAI
DEEPGRAM_API_KEY=your_deepgram_api_key
# LLM: OpenAI / Groq / Qwen / Claude
OPENAI_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini
# TTS: Cartesia Sonic / Piper / ElevenLabs
CARTESIA_API_KEY=your_cartesia_api_key
