# Copy to .env (gitignored). Never commit real values.

# ---- Required auth: generate two DIFFERENT long random values, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# There are no defaults. If unset, the backend rejects every protected request.
INTERNAL_API_TOKEN=
OPERATOR_API_TOKEN=

# Local-development convenience ONLY: ENVIRONMENT=dev or ENVIRONMENT=test lets an unset token fall
# back to dev-operator-token / dev-internal-token. Leave this blank anywhere reachable by others.
ENVIRONMENT=

# Browsers allowed to call the operator API (comma separated, no wildcard).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Server
HOST=0.0.0.0
PORT=8000
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Dashboard -> backend. Compiled into the browser bundle: local demo only.
NEXT_PUBLIC_OPERATOR_TOKEN=
# Optional: override the SQLite location (default data/app.db)
# AUTOPAY_DB_PATH=

# ---- LiveKit (only for the voice-agent worker; not needed for tests or evals)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# SIP dialing is not implemented; the trunk id only changes the error code (403 -> 501)
LIVEKIT_SIP_TRUNK_ID=
LIVEKIT_SIP_CALLER_ID=

# ---- Model / speech providers (only for the voice-agent worker and the live evals)
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
